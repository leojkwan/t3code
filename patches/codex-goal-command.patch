+++ b/apps/server/src/orchestration-v2/GoalCommand.ts
@@ -0,0 +1,284 @@
+// @effect-diagnostics nodeBuiltinImport:off - Thread goals are one local JSON file. Reading it stays synchronous so turn start and turn finalization do not grow a service requirement.
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import type { ServerProviderSlashCommand } from "@t3tools/contracts";
+
+export const GOAL_SLASH_COMMAND = {
+  name: "goal",
+  description: "Set, read, pause, resume, or clear this thread's goal",
+  input: { hint: "objective, pause, resume, or clear" },
+} satisfies ServerProviderSlashCommand;
+
+export const GOAL_SATISFIED_LINE = "GOAL_SATISFIED";
+
+export type GoalStatus = "active" | "paused" | "satisfied";
+
+export interface ThreadGoal {
+  readonly objective: string;
+  readonly status: GoalStatus;
+  readonly updatedAt: string;
+  readonly lastContinuedRunId?: string;
+}
+
+export interface GoalStore {
+  readonly version: 1;
+  readonly threads: Readonly<Record<string, ThreadGoal>>;
+}
+
+export type GoalCommand =
+  | { readonly type: "read" }
+  | { readonly type: "pause" }
+  | { readonly type: "resume" }
+  | { readonly type: "clear" }
+  | { readonly type: "set"; readonly objective: string };
+
+export interface GoalCommandResult {
+  readonly goal: ThreadGoal | undefined;
+  readonly reply: string;
+  /** True only for set: the provider should run the objective, not the slash text. */
+  readonly startProvider: boolean;
+  readonly providerText?: string;
+}
+
+export type ContinuationDecision =
+  | { readonly action: "continue"; readonly goal: ThreadGoal; readonly text: string }
+  | {
+      readonly action: "stop";
+      readonly goal: ThreadGoal | undefined;
+      readonly reason: "none" | "paused" | "satisfied" | "already-continued";
+    };
+
+const EMPTY_STORE: GoalStore = { version: 1, threads: {} };
+
+export function defaultGoalStorePath(home: string = NodeOS.homedir()): string {
+  return NodePath.join(home, ".t3", "userdata", "thread-goals.json");
+}
+
+export function parseGoalCommand(text: string): GoalCommand | null {
+  const match = /^\/goal(?:\s+([\s\S]*))?$/i.exec(text.trim());
+  if (match === null) return null;
+  const rest = (match[1] ?? "").trim();
+  if (rest.length === 0) return { type: "read" };
+  const verb = rest.toLowerCase();
+  if (verb === "pause") return { type: "pause" };
+  if (verb === "resume") return { type: "resume" };
+  if (verb === "clear") return { type: "clear" };
+  return { type: "set", objective: rest };
+}
+
+export const GOAL_STOP_INSTRUCTION = `When that end state is met, end with a line that is exactly ${GOAL_SATISFIED_LINE}.`;
+
+export function goalProviderText(objective: string): string {
+  return `${objective}\n\n${GOAL_STOP_INSTRUCTION}`;
+}
+
+export function goalContinuationMessageId(runId: string): string {
+  return `message:goal-continuation:${runId}`;
+}
+
+/** GLM is the only ACP agent whose menu advertises the shared T3 goal loop. */
+export function persistentGoalMenu(input: {
+  readonly agentId?: string | undefined;
+  readonly instanceId?: string | undefined;
+  readonly displayName?: string | undefined;
+}): boolean {
+  return [input.agentId, input.instanceId, input.displayName].some((value) =>
+    value?.toLowerCase().includes("glm"),
+  );
+}
+
+function describeGoal(goal: ThreadGoal | undefined): string {
+  if (goal === undefined) return "No goal is set.";
+  return `Goal is ${goal.status}: ${goal.objective}`;
+}
+
+export function applyGoalCommand(
+  current: ThreadGoal | undefined,
+  command: GoalCommand,
+  now: string,
+): GoalCommandResult {
+  switch (command.type) {
+    case "read":
+      return { goal: current, reply: describeGoal(current), startProvider: false };
+    case "clear":
+      return { goal: undefined, reply: "Goal cleared.", startProvider: false };
+    case "pause":
+      if (current === undefined || current.status !== "active") {
+        return {
+          goal: current,
+          reply: "No active goal to pause.",
+          startProvider: false,
+        };
+      }
+      return {
+        goal: { ...current, status: "paused", updatedAt: now },
+        reply: "Goal paused.",
+        startProvider: false,
+      };
+    case "resume":
+      if (current === undefined || current.status !== "paused") {
+        return {
+          goal: current,
+          reply: "No paused goal to resume.",
+          startProvider: false,
+        };
+      }
+      return {
+        goal: { ...current, status: "active", updatedAt: now },
+        reply: "Goal resumed.",
+        startProvider: false,
+      };
+    case "set": {
+      const goal: ThreadGoal = {
+        objective: command.objective,
+        status: "active",
+        updatedAt: now,
+      };
+      return {
+        goal,
+        reply: `Goal set: ${command.objective}`,
+        startProvider: true,
+        providerText: goalProviderText(command.objective),
+      };
+    }
+  }
+}
+
+export function assistantSatisfiedGoal(text: string): boolean {
+  return text.split(/\r?\n/).some((line) => line.trim() === GOAL_SATISFIED_LINE);
+}
+
+export function decideContinuation(input: {
+  readonly goal: ThreadGoal | undefined;
+  readonly runId: string;
+  readonly assistantText: string;
+  readonly now: string;
+}): ContinuationDecision {
+  const goal = input.goal;
+  if (goal === undefined) return { action: "stop", goal: undefined, reason: "none" };
+  if (goal.status === "paused") return { action: "stop", goal, reason: "paused" };
+  if (goal.status === "satisfied" || assistantSatisfiedGoal(input.assistantText)) {
+    return {
+      action: "stop",
+      goal: { ...goal, status: "satisfied", updatedAt: input.now },
+      reason: "satisfied",
+    };
+  }
+  if (goal.lastContinuedRunId === input.runId) {
+    return { action: "stop", goal, reason: "already-continued" };
+  }
+  const continued: ThreadGoal = {
+    ...goal,
+    updatedAt: input.now,
+    lastContinuedRunId: input.runId,
+  };
+  return {
+    action: "continue",
+    goal: continued,
+    text: `Continue the active goal until its verifiable end state is met.\n\n${goal.objective}\n\n${GOAL_STOP_INSTRUCTION}`,
+  };
+}
+
+const CLOSED_SOURCE_STATUSES = new Set(["failed", "cancelled", "interrupted", "rolled_back"]);
+
+export type GoalContinuationPlan =
+  | { readonly action: "retry" }
+  | { readonly action: "skip" }
+  | { readonly action: "satisfy"; readonly goal: ThreadGoal }
+  | { readonly action: "dispatch"; readonly text: string; readonly goal: ThreadGoal };
+
+/**
+ * One admission decision for a finished run. Dispatch is the only action that
+ * starts another turn, and it stamps the source run so a replay cannot send twice.
+ */
+export function planGoalContinuation(input: {
+  readonly closed: boolean;
+  readonly sourceStatus: string | undefined;
+  readonly continuationAlreadySent: boolean;
+  readonly laterRunExists: boolean;
+  readonly goal: ThreadGoal | undefined;
+  readonly runId: string;
+  readonly assistantText: string;
+  readonly now: string;
+}): GoalContinuationPlan {
+  if (
+    input.closed ||
+    input.sourceStatus === undefined ||
+    CLOSED_SOURCE_STATUSES.has(input.sourceStatus)
+  ) {
+    return { action: "skip" };
+  }
+  if (input.sourceStatus !== "completed") return { action: "retry" };
+  if (input.continuationAlreadySent || input.laterRunExists) return { action: "skip" };
+  const decision = decideContinuation({
+    goal: input.goal,
+    runId: input.runId,
+    assistantText: input.assistantText,
+    now: input.now,
+  });
+  if (decision.action === "stop") {
+    if (decision.reason === "satisfied" && decision.goal !== undefined) {
+      return { action: "satisfy", goal: decision.goal };
+    }
+    return { action: "skip" };
+  }
+  if (decision.text.startsWith("/")) return { action: "skip" };
+  return { action: "dispatch", text: decision.text, goal: decision.goal };
+}
+
+export function goalContinuationRequested(
+  terminalStatus: string,
+  goalStatus: GoalStatus | undefined,
+): boolean {
+  return terminalStatus === "completed" && goalStatus === "active";
+}
+
+export function threadGoalContinueEffectId(runId: string): string {
+  return `effect:thread-goal.continue:${runId}`;
+}
+
+export function withGoalSlashCommand<T extends { readonly name: string }>(
+  commands: ReadonlyArray<T>,
+): ReadonlyArray<T | typeof GOAL_SLASH_COMMAND> {
+  if (commands.some((command) => command.name === "goal")) return commands;
+  return [GOAL_SLASH_COMMAND, ...commands];
+}
+
+export function readGoalStore(path: string): GoalStore {
+  try {
+    const parsed = JSON.parse(NodeFS.readFileSync(path, "utf8")) as Partial<GoalStore>;
+    if (
+      parsed.version !== 1 ||
+      parsed.threads === undefined ||
+      typeof parsed.threads !== "object"
+    ) {
+      return EMPTY_STORE;
+    }
+    return { version: 1, threads: parsed.threads };
+  } catch {
+    return EMPTY_STORE;
+  }
+}
+
+export function writeGoalStore(path: string, store: GoalStore): void {
+  NodeFS.mkdirSync(NodePath.dirname(path), { recursive: true });
+  const temporary = `${path}.${process.pid}.tmp`;
+  NodeFS.writeFileSync(temporary, `${JSON.stringify(store)}\n`);
+  NodeFS.renameSync(temporary, path);
+}
+
+export function updateThreadGoal(
+  path: string,
+  threadId: string,
+  goal: ThreadGoal | undefined,
+): GoalStore {
+  const current = readGoalStore(path);
+  const threads = { ...current.threads };
+  if (goal === undefined) delete threads[threadId];
+  else threads[threadId] = goal;
+  const next: GoalStore = { version: 1, threads };
+  writeGoalStore(path, next);
+  return next;
+}
