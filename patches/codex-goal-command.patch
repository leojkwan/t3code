+// @effect-diagnostics nodeBuiltinImport:off - The store round-trip uses a temporary directory.
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import { describe, expect, it } from "@effect/vitest";
+
+import {
+  applyGoalCommand,
+  decideContinuation,
+  goalContinuationRequested,
+  goalProviderText,
+  parseGoalCommand,
+  persistentGoalMenu,
+  planGoalContinuation,
+  readGoalStore,
+  threadGoalContinueEffectId,
+  updateThreadGoal,
+  withGoalSlashCommand,
+} from "./GoalCommand.ts";
+
+describe("goal commands", () => {
+  it("advertises the persistent loop only for GLM identities", () => {
+    expect(persistentGoalMenu({ agentId: "glm-acp-agent" })).toBe(true);
+    expect(persistentGoalMenu({ instanceId: "acpRegistry_glm_agent" })).toBe(true);
+    expect(persistentGoalMenu({ displayName: "GLM (Z Code plan)" })).toBe(true);
+    expect(persistentGoalMenu({ agentId: "test-agent", instanceId: "acpRegistry_test" })).toBe(
+      false,
+    );
+  });
+
+  it("parses set, read, pause, resume, and clear", () => {
+    expect(parseGoalCommand("hello")).toBeNull();
+    expect(parseGoalCommand("  /goal  ")).toEqual({ type: "read" });
+    expect(parseGoalCommand("/goal pause")).toEqual({ type: "pause" });
+    expect(parseGoalCommand("/GOAL resume")).toEqual({ type: "resume" });
+    expect(parseGoalCommand("/goal clear")).toEqual({ type: "clear" });
+    expect(parseGoalCommand("/goal ship the fix")).toEqual({
+      type: "set",
+      objective: "ship the fix",
+    });
+  });
+
+  it("keeps the provider prompt from looking like a native slash command", () => {
+    const set = applyGoalCommand(undefined, { type: "set", objective: "ship the fix" }, "t0");
+    expect(set.startProvider).toBe(true);
+    expect(set.providerText?.startsWith("/")).toBe(false);
+    expect(set.providerText).toContain("ship the fix");
+    expect(set.providerText).toContain("GOAL_SATISFIED");
+    expect(goalProviderText("ship the fix").startsWith("/")).toBe(false);
+  });
+
+  it("reads, pauses, resumes, and clears without starting a provider turn", () => {
+    const set = applyGoalCommand(undefined, { type: "set", objective: "ship the fix" }, "t0");
+    expect(applyGoalCommand(set.goal, { type: "read" }, "t1")).toMatchObject({
+      startProvider: false,
+      reply: "Goal is active: ship the fix",
+    });
+    const paused = applyGoalCommand(set.goal, { type: "pause" }, "t2");
+    expect(paused.goal?.status).toBe("paused");
+    expect(paused.startProvider).toBe(false);
+    const resumed = applyGoalCommand(paused.goal, { type: "resume" }, "t3");
+    expect(resumed.goal?.status).toBe("active");
+    const cleared = applyGoalCommand(resumed.goal, { type: "clear" }, "t4");
+    expect(cleared.goal).toBeUndefined();
+    expect(cleared.reply).toBe("Goal cleared.");
+    expect(applyGoalCommand(undefined, { type: "pause" }, "t5").reply).toBe(
+      "No active goal to pause.",
+    );
+  });
+
+  it("continues once per run, stops when paused or satisfied, and does not double-continue", () => {
+    const active = applyGoalCommand(
+      undefined,
+      { type: "set", objective: "ship the fix" },
+      "t0",
+    ).goal;
+    const first = decideContinuation({
+      goal: active,
+      runId: "run-1",
+      assistantText: "still working",
+      now: "t1",
+    });
+    expect(first.action).toBe("continue");
+    if (first.action !== "continue") return;
+    expect(first.text.startsWith("/")).toBe(false);
+    expect(first.goal.lastContinuedRunId).toBe("run-1");
+
+    const duplicate = decideContinuation({
+      goal: first.goal,
+      runId: "run-1",
+      assistantText: "still working",
+      now: "t2",
+    });
+    expect(duplicate).toMatchObject({ action: "stop", reason: "already-continued" });
+
+    const paused = applyGoalCommand(active, { type: "pause" }, "t3").goal;
+    expect(
+      decideContinuation({
+        goal: paused,
+        runId: "run-2",
+        assistantText: "done?",
+        now: "t4",
+      }),
+    ).toMatchObject({ action: "stop", reason: "paused" });
+
+    const satisfied = decideContinuation({
+      goal: active,
+      runId: "run-2",
+      assistantText: "verified\nGOAL_SATISFIED\n",
+      now: "t5",
+    });
+    expect(satisfied).toMatchObject({ action: "stop", reason: "satisfied" });
+    if (satisfied.action === "stop") expect(satisfied.goal?.status).toBe("satisfied");
+  });
+
+  it("admits one continuation and refuses a second send", () => {
+    const active = applyGoalCommand(
+      undefined,
+      { type: "set", objective: "ship the fix" },
+      "t0",
+    ).goal;
+    const base = {
+      closed: false,
+      sourceStatus: "completed",
+      continuationAlreadySent: false,
+      laterRunExists: false,
+      goal: active,
+      runId: "run-1",
+      assistantText: "still working",
+      now: "t1",
+    };
+    const admitted = planGoalContinuation(base);
+    expect(admitted.action).toBe("dispatch");
+    if (admitted.action !== "dispatch") return;
+    expect(admitted.text.startsWith("/")).toBe(false);
+    expect(admitted.text).toContain("ship the fix");
+    expect(admitted.goal.lastContinuedRunId).toBe("run-1");
+
+    expect(planGoalContinuation({ ...base, goal: admitted.goal, now: "t2" })).toMatchObject({
+      action: "skip",
+    });
+    expect(planGoalContinuation({ ...base, continuationAlreadySent: true })).toMatchObject({
+      action: "skip",
+    });
+    expect(planGoalContinuation({ ...base, laterRunExists: true })).toMatchObject({
+      action: "skip",
+    });
+    expect(planGoalContinuation({ ...base, closed: true })).toMatchObject({ action: "skip" });
+    expect(planGoalContinuation({ ...base, sourceStatus: "failed" })).toMatchObject({
+      action: "skip",
+    });
+    expect(planGoalContinuation({ ...base, sourceStatus: "waiting" })).toMatchObject({
+      action: "retry",
+    });
+    expect(planGoalContinuation({ ...base, assistantText: "done\nGOAL_SATISFIED" })).toMatchObject({
+      action: "satisfy",
+      goal: { status: "satisfied" },
+    });
+    expect(planGoalContinuation({ ...base, goal: undefined })).toMatchObject({ action: "skip" });
+
+    expect(goalContinuationRequested("completed", "active")).toBe(true);
+    expect(goalContinuationRequested("completed", "paused")).toBe(false);
+    expect(goalContinuationRequested("interrupted", "active")).toBe(false);
+    expect(goalContinuationRequested("completed", undefined)).toBe(false);
+    const runId = "run-1";
+    expect(`effect:checkpoint.capture:${runId}` < threadGoalContinueEffectId(runId)).toBe(true);
+  });
+
+  it("round-trips a goal store and advertises the command once", () => {
+    const dir = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-goal-store-"));
+    const path = NodePath.join(dir, "nested", "thread-goals.json");
+    const goal = applyGoalCommand(undefined, { type: "set", objective: "ship the fix" }, "t0").goal;
+    updateThreadGoal(path, "thread-1", goal);
+    expect(readGoalStore(path).threads["thread-1"]?.objective).toBe("ship the fix");
+    updateThreadGoal(path, "thread-1", undefined);
+    expect(readGoalStore(path).threads["thread-1"]).toBeUndefined();
+    expect(withGoalSlashCommand([{ name: "compact" }]).map((command) => command.name)).toEqual([
+      "goal",
+      "compact",
+    ]);
+    expect(withGoalSlashCommand([{ name: "goal" }])).toEqual([{ name: "goal" }]);
+  });
+
+  it("keeps one Codex thread goal from slash text and continues a completed run once", () => {
+    const dir = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-goal-codex-"));
+    const path = NodePath.join(dir, "thread-goals.json");
+    const threadId = "thread-codex";
+    const command = (text: string) => {
+      const parsed = parseGoalCommand(text);
+      if (parsed === null) throw new Error(`expected a goal command: ${text}`);
+      return parsed;
+    };
+    const set = applyGoalCommand(undefined, command("/goal ship the fix"), "t0");
+    expect(set.startProvider).toBe(true);
+    expect(set.providerText?.startsWith("/")).toBe(false);
+    expect(set.providerText).not.toContain("/goal");
+    expect(set.goal?.status).toBe("active");
+    updateThreadGoal(path, threadId, set.goal);
+    expect(readGoalStore(path).threads[threadId]).toMatchObject({
+      objective: "ship the fix",
+      status: "active",
+    });
+    expect(Object.keys(readGoalStore(path).threads)).toEqual([threadId]);
+
+    const stored = () => readGoalStore(path).threads[threadId];
+    const read = applyGoalCommand(stored(), command("/goal"), "t1");
+    expect(read.startProvider).toBe(false);
+    expect(read.reply).toBe("Goal is active: ship the fix");
+    expect(read.goal).toEqual(stored());
+
+    const paused = applyGoalCommand(stored(), command("/goal pause"), "t2");
+    expect(paused.startProvider).toBe(false);
+    expect(paused.goal?.status).toBe("paused");
+    updateThreadGoal(path, threadId, paused.goal);
+    const base = {
+      closed: false,
+      sourceStatus: "completed",
+      continuationAlreadySent: false,
+      laterRunExists: false,
+      runId: "run-1",
+      assistantText: "still working",
+      now: "t3",
+    };
+    expect(planGoalContinuation({ ...base, goal: stored() })).toMatchObject({ action: "skip" });
+
+    const resumed = applyGoalCommand(stored(), command("/goal resume"), "t4");
+    expect(resumed.startProvider).toBe(false);
+    expect(resumed.goal?.status).toBe("active");
+    updateThreadGoal(path, threadId, resumed.goal);
+    const admitted = planGoalContinuation({ ...base, goal: stored(), now: "t5" });
+    expect(admitted.action).toBe("dispatch");
+    if (admitted.action !== "dispatch") return;
+    expect(admitted.text.startsWith("/")).toBe(false);
+    expect(admitted.text).toContain("ship the fix");
+    updateThreadGoal(path, threadId, admitted.goal);
+    expect(planGoalContinuation({ ...base, goal: stored(), now: "t6" })).toMatchObject({
+      action: "skip",
+    });
+    expect(
+      planGoalContinuation({ ...base, goal: stored(), sourceStatus: "failed", now: "t7" }),
+    ).toMatchObject({ action: "skip" });
+    expect(
+      planGoalContinuation({
+        ...base,
+        goal: applyGoalCommand(undefined, command("/goal ship the fix"), "t0").goal,
+        runId: "run-2",
+        assistantText: "GOAL_SATISFIED",
+        now: "t8",
+      }),
+    ).toMatchObject({ action: "satisfy", goal: { status: "satisfied" } });
+
+    const cleared = applyGoalCommand(stored(), command("/goal clear"), "t9");
+    expect(cleared.startProvider).toBe(false);
+    expect(cleared.goal).toBeUndefined();
+    updateThreadGoal(path, threadId, cleared.goal);
+    expect(stored()).toBeUndefined();
+    expect(planGoalContinuation({ ...base, goal: undefined, now: "t10" })).toMatchObject({
+      action: "skip",
+    });
+  });
+});
